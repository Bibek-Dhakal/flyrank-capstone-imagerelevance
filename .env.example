# Application Settings
ENVIRONMENT=development
PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Database Settings
# Note: If running locally via 'uvicorn', use localhost. If running via docker-compose, it overrides this to 'db'.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/imagerelevance

# AI Models / APIs
# Gemini Flash Free Tier (Default for FlyRank Capstone)
VISION_MODEL=gemini/gemini-3.6-flash
EMBEDDING_MODEL=gemini/gemini-embedding-2
GEMINI_API_KEY=your_gemini_key_here

# Ollama / Local fallback (Optional)
OLLAMA_API_BASE=http://localhost:11434
